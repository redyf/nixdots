# `nix fmt` formats the tree; `nix flake check` fails if anything would change.
{
  projectRootFile = "flake.nix";

  programs = {
    nixfmt.enable = true;
    statix.enable = true;
  };

  settings.global.excludes = [
    # Generated by nixos-generate-config.
    "hosts/*/hardware-configuration.nix"
    "*.lock"
  ];
}
